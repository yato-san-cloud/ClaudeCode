# MEDICALPASS のログイン情報（.env にコピーして記入。gitには絶対にコミットしない）
MEDICALPASS_EMAIL=you@example.com
MEDICALPASS_PASSWORD=your-password

# 任意: 予約結果の通知先 Webhook (Discord / Slack の Incoming Webhook URL)
# NOTIFY_WEBHOOK_URL=https://discord.com/api/webhooks/...

# 任意: LINE通知 (LINE Developers の Messaging API チャネル。READMEの手順参照)
# LINE_CHANNEL_ACCESS_TOKEN=チャネルアクセストークン（長期）
# LINE_USER_ID=あなたのユーザーID（Uで始まる文字列）
