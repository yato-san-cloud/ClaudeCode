{
  "template_id": "ecommerce_small",
  "name": "EC物流・人手ピッキング (small)",
  "description": "小規模 EC 倉庫。人手シングルピッキング。提案ヒアリングの出発点。",
  "subtree_source": {
    "meta": "interview",
    "layout": "data",
    "locations": "data",
    "items": "data",
    "process": "interview",
    "resources": "interview",
    "orders": "data",
    "simulation": "interview"
  },
  "headline_fields": [
    {
      "path": "resources.workers.0.count",
      "label": "ピッカー人数",
      "type": "int",
      "unit": "名"
    },
    {
      "path": "orders.profile.rate_per_hr",
      "label": "出荷オーダー",
      "type": "float",
      "unit": "件/時"
    },
    {
      "path": "process.pick_strategy",
      "label": "ピッキング方式",
      "type": "choice",
      "choices": [
        {
          "value": "discrete",
          "label": "シングルオーダー"
        },
        {
          "value": "batch",
          "label": "マルチオーダー"
        },
        {
          "value": "zone",
          "label": "ゾーン（リレー）"
        },
        {
          "value": "wave",
          "label": "バッチ投入"
        }
      ]
    },
    {
      "path": "simulation.duration_s",
      "label": "稼働時間",
      "type": "float",
      "unit": "時間",
      "scale": 3600
    },
    {
      "path": "process.walk_speed_mps",
      "label": "歩行速度",
      "type": "float",
      "unit": "m/s"
    },
    {
      "path": "process.staging_capacity",
      "label": "仮置き容量(0=兼任)",
      "type": "int",
      "unit": "個"
    }
  ]
}
