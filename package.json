{
  "name": "line-shopping-list",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "wrangler d1 create shopping",
    "db:migrate:local": "wrangler d1 migrations apply shopping --local",
    "db:migrate": "wrangler d1 migrations apply shopping --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260726.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
